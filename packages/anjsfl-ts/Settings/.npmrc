# 是否生成package-lock.json文件
package-lock=false

# 日志级别
loglevel=warn

# 全局安装权限
unsafe-perm=true

# 保存精确版本号
save-exact=true


# 设置全局目录（仅当前会话或需写入配置）
# pnpm config set global-dir "F:\npm\pnpm-global\node_modules"
# pnpm config set global-bin-dir "F:\npm\pnpm-global"

# 源
# pnpm config get registry
registry=https://registry.npmmirror.com

