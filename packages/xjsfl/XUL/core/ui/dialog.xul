<dialog id="dialog" title=" Compound control values" buttons="accept,cancel">
	<content>
		<grid>
			<columns id="columns">
				<column flex="1"/>
				<column flex="2"/>
			</columns>
			<rows id="controls">
				<row>
					<script>function click(event) {console.log("CLICK: " + event);console.json(event.xul.controls);}</script>
				</row>
				<row template="label">
					<label value="label0000" align="" width="100"/>
				</row>
				<row>
					<property template="property" id="idddd" oncreate="if(window.xjsfl)xjsfl.ui.handleEvent('0', 'create', 'idddd');"/>
				</row>
			</rows>
		</grid>
	</content>
	<script>if(window.xjsfl)
			{
				xjsfl.ui.handleEvent(0, 'initialize');
			}</script>
	<property id="xulid" value="0"/>
</dialog>