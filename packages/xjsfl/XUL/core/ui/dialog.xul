<dialog id="dialog" title=" Compound control values" buttons="accept,cancel" width="100" height="200">
	<content id="controls">
		<element template="flash">
			<flash class="control" id="flash" src="path/to/aa.swf" width="100" height="200" oncreate="if(window.xjsfl)xjsfl.ui.handleEvent('0', 'create', 'flash');"/>
		</element>
		<row>
			<property template="property" id="property1" oncreate="if(window.xjsfl)xjsfl.ui.handleEvent('0', 'create', 'property1');"/>
		</row>
		<row>
			<property template="property" id="p2" oncreate="if(window.xjsfl)xjsfl.ui.handleEvent('0', 'create', 'p2');"/>
		</row>
		<row>
			<property template="property" id="p3" oncreate="if(window.xjsfl)xjsfl.ui.handleEvent('0', 'create', 'p3');"/>
		</row>
	</content>
	<script>if(window.xjsfl)
			{
				xjsfl.ui.handleEvent(0, 'initialize');
			}</script>
	<property id="xulid" value="0"/>
</dialog>