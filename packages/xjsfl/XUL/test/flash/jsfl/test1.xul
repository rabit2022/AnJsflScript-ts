<dialog id="dialog" title=" Compound control values" buttons="accept,cancel">
    <content>
        <grid>
            <columns id="columns">
                <column flex="1"/>
                <column flex="2"/>
            </columns>
            <rows id="controls">
                <row template="label">
                    <label value="label0000" align="" width="100"/>
                </row>



<!--                    </rows>-->
<!--                </grid><separator/><grid>-->
<!--                <columns>-->
<!--                    <column flex="1"/>-->
<!--                    <column flex="2"/>-->
<!--                </columns>-->
<!--                <rows>-->

                    <separator/>



                    <row template="label">
                        <label value="label0000" align="" width="100"/>
                    </row>
            </rows>
        </grid>
    </content>
    <script>if(window.xjsfl)
        {
        xjsfl.ui.handleEvent(0, 'initialize');
        }
    </script>
    <property id="xulid" value="0"/>
</dialog>