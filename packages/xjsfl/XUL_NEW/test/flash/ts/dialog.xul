<dialog id="dialog" title=" Compound control values" buttons="accept,cancel">
	<content>
		<grid>
			<columns id="columns">
				<column flex="1"/>
				<column flex="2"/>
			</columns>
			<rows id="controls">
				<row template="textbox">
					<label value="Text00000 : " width="100"/>
					<textbox class="control" id="text00000" value="" maxlength="" prompt="kb,b," size="" multiline="false" width="180" flex="1" oncreate="if(window.xjsfl)xjsfl.ui.handleEvent('0', 'create', 'text00000');" onchange="if(window.xjsfl)xjsfl.ui.handleEvent('0', 'change', 'text00000');"/>
				</row>
				<row template="textbox">
					<label value="Text00001 : " width="100"/>
					<textbox class="control" id="text00001" value="" maxlength="" prompt="kb,b," size="" multiline="false" width="180" flex="1" oncreate="if(window.xjsfl)xjsfl.ui.handleEvent('0', 'create', 'text00001');" onchange="if(window.xjsfl)xjsfl.ui.handleEvent('0', 'change', 'text00001');"/>
				</row>
			</rows>
		</grid>
	</content>
	<script>if(window.xjsfl)
		{
		xjsfl.ui.handleEvent(0, 'initialize');
		}</script>
	<property id="xulid" value="0"/>
</dialog>