<dialog id="dialog" title=" Compound control values" buttons="accept,cancel">
    <content>
        <grid>
            <columns id="columns">
                <column flex="1"/>
                <column flex="2"/>
            </columns>
            <rows id="controls">
                <row template="listbox">
                    <label value="Listbox : " width="100"/>
                    <listbox class="control" id="listbox" width="180" flex="1" rows="6" tabindex=""
