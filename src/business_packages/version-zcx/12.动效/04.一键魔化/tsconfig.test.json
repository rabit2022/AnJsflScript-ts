{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "./dist",
    // 避免和 webpack 的 dist 冲突

    //    "type": "module",
    "paths": [],
    "importHelpers": true,
    "types": [
      "jest"
    ],
    "target": "es5",
    "lib": [
      "es5",
      "es6"
    ],
    // 👈 关键！只允许 ES5 的全局 API

    // 👇 关键修复
    "composite": true,
    "declaration": true,
    // 必须为 true
    "declarationMap": true,
    "emitDeclarationOnly": false
  },
  "include": [
    "test",
    "src",
    // region TYPES
    // jsfl
    "../../../../../types/jsfl/types/**/*.d.ts",
    // 全局的 类型定义文件
    "../../../../../types/myShim/*.d.ts"
// endregion TYPES
  ]
}
