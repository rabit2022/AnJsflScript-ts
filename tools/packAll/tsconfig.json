{
  "compilerOptions": {
    "module": "commonjs",

    "strict": true,
    "noEmitOnError": false,
//    "removeComments": true,

    // node import
    "moduleResolution": "node",

    "importHelpers": true,       // 👈 关键！启用从 tslib 导入 helpers

    // 允许 TypeScript 将项目作为依赖进行增量编译
    "composite": true,
    "declaration": true,

    "rootDir": "./src",
    "outDir": "./dist",

//    "outFile": "./dist/index.jsfl",

    "types": ["node"],
    "target": "es5",
    "lib": [
      "es5",
      "es6"
    ]
  },
  "include": [
    "src",

    // region TYPES
    // jsfl
    "../../types/jsfl/types/**/*.d.ts",
    // 全局的 类型定义文件
    "../../types/myShim/*.d.ts"
// endregion TYPES
  ]
}