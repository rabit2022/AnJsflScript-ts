{
  "name": "AnJsflScript-ts",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.29.2",
  "description": "是一个专为 Adobe Animate 设计的 JavaScript For Flash (JSFL)脚本集合，旨在通过自动化任务提升工作效率，帮助用户更高效地完成重复性工作，从而专注于创意与设计。",
  "author": {
    "name": "穹的兔兔",
    "email": "3101829204@qq.com",
    "qq": "3101829204",
    "QQ群": "1040730457"
  },
  "license": "LGPL-3.0-or-later",
  "keywords": [
    "Adobe Animate",
    "JavaScript For Flash",
    "JSFL",
    "scripts",
    "automation",
    "Efficiency",
    "Improvement",
    "Creativity",
    "Design"
  ],
  "scripts": {
    // 代码质量    prettier
    "format": "prettier --write **/*.ts --config config/codestyle/.prettierrc --ignore-path config/codestyle/.prettierignore",

    // requirejs  module  注册
    //    src/out  自定义模块，单文件
    //    third  第三方模块
    //    packages  自定义模块
    // 写入到   config\require\require.config.jsfl
    "generate_config": "tsx ./tools/project/src/require/generate_config.ts",


    // 生成package,json文件，方便注释
    "preinstall": "pnpm add -w json5 && tsx ./tools/project/src/package/sync-package.ts && npx only-allow pnpm ",
    "update-package-json": "tsx ./tools/project/src/package/sync-package.ts",
    "pnpm install": "pnpm install",


    // ts编译 jsfl，
    // src/business脚本文件             -->    out
    // src/business_packages脚本文件    -->    out
    // src/lib库文件                   -->    src/out
    "build": "npx tsc && tsx ./tools/project/src/typescript/build_all.ts",


    // 删除build缓存，build文件夹
    "clean": "npx tsc --build --clean && tsx ./tools/project/clean/CleanAll.ts",


    // 添加文件头
    "addHeaders": "tsx ./tools/project/src/headers/addFileHeader.ts"
  },
  "devDependencies": {
    // npm install @types/rxjs --save-dev
    // npm install cli-table3 --save-dev


    // =================================================================================
    //  third modules
    //  "H:\project\js\AnJsflScript-ts\third\utils"
    "@types/linq": "2.2.33",
    "@types/lodash": "4.17.23",
    "lodash": "4.17.23",
    "store-js": "2.0.4",
    //    "H:\project\js\AnJsflScript-ts\third\checker"
    // skip

    //    "H:\project\js\AnJsflScript-ts\third\color"
    "@types/chroma-js": "3.1.2",
    "chroma-js": "3.2.0",

    //    "H:\project\js\AnJsflScript-ts\third\console"
    "cli-table3": "0.6.5",
    "@types/loglevel": "1.6.3",
    "loglevel": "1.9.2",
    "@types/progress": "2.0.7",
    "@types/error-stack-parser": "2.0.2",


    //    "H:\project\js\AnJsflScript-ts\third\nodejs"
    "@types/eventemitter3": "2.0.4",
    // rxjs skip
    "@types/path-browserify": "1.0.3",
    "path-browserify": "1.0.1",

    // util skip

    //    "H:\project\js\AnJsflScript-ts\third\polyfill"
    // skip all

//    H:\project\js\AnJsflScript-ts\third\regex

    // 支持通配符 *
    "@types/micromatch": "4.0.10",
    "micromatch": "4.0.8",

    // 支持正则带注释
    "@types/xregexp": "4.4.0",
    "xregexp": "5.1.2",

    //    "H:\project\js\AnJsflScript-ts\third\require"
    // requirejs  skip
    // requirejs是ts转译后的模块，完全的跳过他


    //    "H:\project\js\AnJsflScript-ts\third\time"
    "@types/luxon": "3.7.1",
    //    "H:\project\js\AnJsflScript-ts\third\types"
    // rust 风格的Result代码支持
    "oxide.ts": "1.1.0",
    // =================================================================================
    // packages
    //    "H:\project\js\AnJsflScript-ts\packages\xjsfl"
    //    "H:\project\js\AnJsflScript-ts\packages\anjsfl"
    //    "H:\project\js\AnJsflScript-ts\packages\dom"
    //    "H:\project\js\AnJsflScript-ts\packages\nodejs"
    "@types/node": "25.0.7",
    //    "H:\project\js\AnJsflScript-ts\packages\polyfills"
    "json5": "2.2.3",


    // =================================================================================
    // 代码质量
    "eslint": "9.26.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.2.3",
    "prettier": "3.5.2",
    // =================================================================================
    // jest test相关
    "jest": "30.2.0",
    "@types/jest": "30.0.0",
//    "minimatch": "10.1.1",
    "strip-json-comments": "3.1.0",
    "ts-jest": "29.4.6",
    // =================================================================================
    // ts相关
    "ts-loader": "9.5.4",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.21.0",
    // ts不要更新版本
    // ts6  过度版本
    // ts7 go版本，预计不再兼容es5环境，amd模块也不再支持
    "typescript": "5.9.3",
    "tslib": "^2.8.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rabit2022/AnJsflScript-ts"
  },
  "readmeFilename": "README.md",
  "dependencies": {

    // "preinstall" 安装json5
    "json5": "2.2.3",


    // pnpm install @anjsfl/validation@workspace:* -w
    // pnpm install

//    "H:\project\js\AnJsflScript-ts\packages\xjsfl"
    "@xjsfl/Constants": "workspace:*",
    "@xjsfl/Context": "workspace:*",
    "@xjsfl/UI": "workspace:*",
    "@xjsfl/Events": "workspace:*",
    "@xjsfl/super": "workspace:*",
    "@xjsfl/XUL": "workspace:*",
    "@xjafl/Collection": "workspace:*",


//    "H:\project\js\AnJsflScript-ts\packages\anjsfl"
    "@anjsfl/validation": "workspace:*",
    "@anjsfl/parser": "workspace:*",
    "@anjsfl/tween": "workspace:*",
    "@anjsfl/sat": "workspace:*",
    "@anjsfl/random": "workspace:*",
    "@anjsfl/more-element": "workspace:*",


    //    "H:\project\js\AnJsflScript-ts\packages\anjsfl-ts"
    "@anjsfl-ts/Sessions": "workspace:*",
    "@anjsfl-ts/dev": "workspace:*",

//    "H:\project\js\AnJsflScript-ts\packages\dom"
    "@dom/setTimeout": "workspace:*",
//    "console.stack": "workspace:*",
//    "console.table": "workspace:*"

    //    "H:\project\js\AnJsflScript-ts\packages\nodejs"
    // skip all ,using "@types/node"

//    "H:\project\js\AnJsflScript-ts\packages\polyfills"

  }
}
